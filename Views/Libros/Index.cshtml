@model List<Biblioteca.Models.Libro>

@{
    ViewData["Title"] = "Libros";
    var autores = (List<Biblioteca.Models.Autor>)ViewBag.Autores;
    var esAdmin = User.IsInRole(RolesApp.Administrador);
    var puedeGestionar = esAdmin || User.IsInRole(RolesApp.Bibliotecario);
    var rol = RolesApp.RolDe(User);
}

<section class="catalog-header">
    <div>
        <span class="hero-eyebrow">Catálogo</span>
        <h2 class="section-title-lg">Lista de Libros</h2>
    </div>
    @if (puedeGestionar)
    {
        <a asp-action="Create" class="btn btn-primary">+ Agregar libro</a>
    }
</section>

@if (!puedeGestionar)
{
    <div class="acceso-aviso" role="note">
        Estás en modo <strong>consulta</strong> como <span class="tag rol-tag rol-lector">@(rol ?? "Lector")</span>.
        Para agregar, editar o eliminar libros se necesita el rol Bibliotecario o Administrador.
    </div>
}
else if (!esAdmin)
{
    <div class="acceso-aviso" role="note">
        Como <span class="tag rol-tag rol-bibliotecario">Bibliotecario</span> podés agregar y editar libros. Eliminar está reservado al Administrador.
    </div>
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-secondary">
        Todavía no hay libros registrados.
        @if (puedeGestionar)
        {
            <text>Hacé clic en <strong>+ Agregar libro</strong> para cargar el primero.</text>
        }
    </div>
}

<div class="book-catalog-grid">
    @foreach (var libro in Model)
    {
        var autor = autores.FirstOrDefault(a => a.Id == libro.AutorId);
        <div class="book-catalog-card">
            <div class="book-catalog-cover">
                <img src="@(string.IsNullOrEmpty(libro.ImagenUrl) ? "/images/sin-imagen.svg" : libro.ImagenUrl)"
                     alt="@libro.Titulo" />
            </div>
            <div class="book-catalog-body">
                <h5 class="book-catalog-title">@libro.Titulo</h5>
                <p class="book-catalog-meta">
                    @libro.Genero (@libro.Anio)<br />
                    Autor: @(autor != null ? autor.Nombre + " " + autor.Apellido : "N/A")
                </p>
                @if (libro.Disponible)
                {
                    <span class="tag tag-forest">Disponible</span>
                }
                else
                {
                    <span class="tag tag-brass">No disponible</span>
                }
            </div>
            <div class="book-catalog-actions">
                <a asp-action="Details" asp-route-id="@libro.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                @if (puedeGestionar)
                {
                    <a asp-action="Edit" asp-route-id="@libro.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                }
                @if (esAdmin)
                {
                    <form asp-action="Delete" asp-route-id="@libro.Id" method="post"
                          onsubmit="return confirm('¿Eliminar @libro.Titulo?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                }
            </div>
        </div>
    }
</div>
