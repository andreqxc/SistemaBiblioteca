@model Biblioteca.Models.Libro

@{
    ViewData["Title"] = "Editar Libro";
    var autores = (List<Biblioteca.Models.Autor>)ViewBag.Autores;
}

<h2>Editar Libro</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label class="form-label">Título</label>
        <input asp-for="Titulo" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Género</label>
        <input asp-for="Genero" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Año</label>
        <input asp-for="Anio" type="number" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Autor</label>
        <select asp-for="AutorId" class="form-select">
            @foreach (var autor in autores)
            {
                <option value="@autor.Id">@autor.Nombre @autor.Apellido</option>
            }
        </select>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="Disponible" class="form-check-input" />
        <label class="form-check-label">Disponible</label>
    </div>
    <div class="mb-3">
        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
        {
            <img src="@Model.ImagenUrl" style="height:120px" class="d-block mb-2 rounded" />
        }
        <label class="form-label">Cambiar Imagen</label>
        <input name="Imagen" type="file" class="form-control" accept="image/*" />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
