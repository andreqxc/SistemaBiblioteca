@model ErrorViewModel
@{
    var noEncontrada = Model.Codigo == 404;
    ViewData["Title"] = noEncontrada ? "Página no encontrada" : "Algo salió mal";

    var estado = noEncontrada
        ? new EstadoPaginaViewModel
        {
            Icono = "🔍",
            Variante = "aviso",
            Titulo = "No encontramos lo que buscabas",
            Mensaje = "La página o el registro que intentaste abrir no existe o fue movido.",
            Sugerencia = "Revisá la dirección o volvé a una de las secciones de la biblioteca."
        }
        : new EstadoPaginaViewModel
        {
            Icono = "📚",
            Variante = "error",
            Titulo = "Algo salió mal de nuestro lado",
            Mensaje = "Ocurrió un problema inesperado mientras procesábamos tu solicitud. Ya quedó registrado para revisarlo.",
            Sugerencia = "Podés intentarlo de nuevo en unos momentos o continuar navegando por la biblioteca.",
            Referencia = Model.ShowRequestId ? Model.RequestId : null
        };
}

<partial name="_EstadoPagina" model="estado" />
