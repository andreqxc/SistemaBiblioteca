@model LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="auth-shell">
    <aside class="auth-aside" aria-hidden="true">
        <span class="auth-eyebrow">Biblioteca Virtual</span>
        <h1 class="auth-aside-title">Tu próxima <em>lectura</em> te está esperando.</h1>
        <p class="auth-aside-text">Ingresá para consultar el catálogo, explorar autores y administrar los libros de la biblioteca.</p>
        <ul class="auth-aside-list">
            <li>Catálogo de libros con portadas</li>
            <li>Autores y categorías organizados</li>
            <li>Acceso desde cualquier dispositivo</li>
        </ul>
        <blockquote class="auth-quote">
            «Siempre imaginé que el Paraíso sería algún tipo de biblioteca.»
            <cite>Jorge Luis Borges</cite>
        </blockquote>
    </aside>

    <div class="auth-panel">
        <header class="auth-panel-header">
            <span class="auth-badge" aria-hidden="true">📖</span>
            <h2 class="auth-title">Iniciar sesión</h2>
            <p class="auth-subtitle">Usá tu nombre de usuario o tu correo electrónico.</p>
        </header>

        @if (TempData["RegistroExitoso"] != null)
        {
            <div class="auth-alert auth-alert-success" role="status">@TempData["RegistroExitoso"]</div>
        }

        <form asp-action="Login" method="post" class="auth-form" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert-error" role="alert"></div>

            <div class="auth-field">
                <label asp-for="UsuarioOCorreo" class="auth-label"></label>
                <div class="auth-input-wrap">
                    <svg class="auth-input-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" /></svg>
                    <input asp-for="UsuarioOCorreo" class="form-control auth-input" placeholder="usuario o correo@ejemplo.com" autocomplete="username" autofocus />
                </div>
                <span asp-validation-for="UsuarioOCorreo" class="auth-field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password" class="auth-label"></label>
                <div class="auth-input-wrap">
                    <svg class="auth-input-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                    <input asp-for="Password" class="form-control auth-input auth-input-pass" placeholder="••••••••" autocomplete="current-password" />
                    <button type="button" class="auth-toggle-pass" data-toggle-password aria-label="Mostrar contraseña">Mostrar</button>
                </div>
                <span asp-validation-for="Password" class="auth-field-error"></span>
            </div>

            <div class="auth-row">
                <div class="form-check form-switch m-0">
                    <input asp-for="Recordarme" class="form-check-input" role="switch" />
                    <label asp-for="Recordarme" class="form-check-label"></label>
                </div>
            </div>

            <button type="submit" class="btn auth-btn">Ingresar</button>
        </form>

        <p class="auth-footer">
            ¿Todavía no tenés cuenta?
            <a asp-action="Registro">Registrate aquí</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
