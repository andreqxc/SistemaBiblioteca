@{
    ViewData["Title"] = "Acceso denegado";
    var rol = RolesApp.RolDe(User) ?? "sin rol asignado";
}

<section class="acceso-denegado">
    <span class="acceso-denegado-icono" aria-hidden="true">🔒</span>
    <h2 class="section-title-lg">No tenés permiso para esta acción</h2>
    <p>
        Iniciaste sesión como <strong>@User.Identity?.Name</strong> con el rol
        <span class="tag rol-tag rol-@rol.ToLower()">@rol</span>, que no permite realizar esta operación.
    </p>
    <p class="text-muted mb-4">
        Agregar y editar libros requiere el rol Bibliotecario o Administrador. Eliminar libros es exclusivo del Administrador.
    </p>
    <div class="acceso-denegado-acciones">
        <a asp-controller="Libros" asp-action="Index" class="btn btn-primary">Ir al catálogo</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Volver al inicio</a>
    </div>
</section>
